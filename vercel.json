{
  "rewrites": [
    {
      "source": "/invite/:path*",
      "destination": "https://jogo-web-two.vercel.app/invite/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "https://jogo-web-two.vercel.app/:path*"
    },
    {
      "source": "/_expo/:path*",
      "destination": "https://jogo-web-two.vercel.app/_expo/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://jogo-web-two.vercel.app/assets/:path*"
    },
    {
      "source": "/((?!app/|invite/).*)",
      "destination": "/index.html"
    }
  ]
}
