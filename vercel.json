{
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "https://jogo-web-two.vercel.app/:path*"
    },
    {
      "source": "/_expo/:path*",
      "destination": "https://jogo-web-two.vercel.app/_expo/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://jogo-web-two.vercel.app/assets/:path*"
    },
    {
      "source": "/crew/:squadId",
      "destination": "/api/crew-page?squadId=:squadId"
    },
    {
      "source": "/invite/:gameId",
      "destination": "/api/invite-page?gameId=:gameId"
    },
    {
      "source": "/((?!app/).*)",
      "destination": "/index.html"
    }
  ]
}
